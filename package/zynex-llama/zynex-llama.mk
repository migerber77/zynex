ZYNEX_LLAMA_VERSION = b12414
ZYNEX_LLAMA_SITE = $(BR2_EXTERNAL_ZYNEX_PATH)/third_party/llama.cpp
ZYNEX_LLAMA_SITE_METHOD = local
ZYNEX_LLAMA_LICENSE = MIT
ZYNEX_LLAMA_INSTALL_STAGING = YES
ZYNEX_LLAMA_INSTALL_TARGET = NO

# Basis fuer Intel ab Haswell (Gen 4) und damit auch Gen 8: AVX2, FMA, F16C.
ZYNEX_LLAMA_CONF_OPTS = \
	-DBUILD_SHARED_LIBS=OFF \
	-DGGML_NATIVE=OFF \
	-DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_BMI2=ON \
	-DGGML_OPENMP=OFF \
	-DLLAMA_BUILD_COMMON=OFF \
	-DLLAMA_BUILD_TESTS=OFF \
	-DLLAMA_BUILD_EXAMPLES=OFF \
	-DLLAMA_BUILD_TOOLS=OFF \
	-DLLAMA_BUILD_SERVER=OFF \
	-DLLAMA_BUILD_APP=OFF \
	-DLLAMA_CURL=OFF \
	-DLLAMA_OPENSSL=OFF

$(eval $(cmake-package))
